<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>نظام الحضور - مستر يسر الموافي</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-white min-h-screen flex items-center justify-center p-4">

    <div id="app" class="bg-white text-gray-900 p-8 rounded-2xl shadow-2xl w-full max-w-md text-center space-y-4">
        <h2 class="text-2xl font-bold text-blue-600">نظام الحضور المدرسي</h2>
        <p class="text-sm text-gray-500">مستر يسر الموافي</p>
        
        <div id="content" class="py-4">
            جاري التحميل...
        </div>
    </div>

    <script>
        // قراءة الرابط
        const urlParams = new URLSearchParams(window.location.search);
        const studentName = urlParams.get('name');
        const studentCode = urlParams.get('code');
        const contentDiv = document.getElementById('content');

        // لو الرابط فيه بيانات طالب (يعني موبايل الطالب عمل سكان للـ QR)
        if (studentName && studentCode) {
            const decodedName = decodeURIComponent(studentName);
            
            // جلب سجل الحضور القديم أو إنشاء واحد جديد
            let logs = JSON.parse(localStorage.getItem('yossr_attendance_logs')) || [];
            const today = new Date().toLocaleDateString('ar-EG');
            
            // منع تكرار تسجيل نفس الطالب في نفس اليوم
            const alreadyLogged = logs.some(l => l.code === studentCode && l.date.includes(today));
            
            if (!alreadyLogged) {
                logs.unshift({
                    name: decodedName,
                    code: studentCode,
                    date: new Date().toLocaleString('ar-EG')
                });
                localStorage.setItem('yossr_attendance_logs', JSON.stringify(logs));
            }

            contentDiv.innerHTML = `
                <div class="bg-green-50 border border-green-200 p-6 rounded-xl space-y-3">
                    <div class="text-4xl">✅</div>
                    <h3 class="text-xl font-bold text-green-800">تم تسجيل حضورك بنجاح!</h3>
                    <p class="text-sm text-gray-700">أهلاً بك يا <b>${decodedName}</b></p>
                    <p class="text-xs text-gray-500 font-mono">الرقم التعريفي: ${studentCode}</p>
                </div>
                <div class="pt-4">
                    <a href="?" class="text-xs text-blue-500 underline">الذهاب للوحة التحكم الرئيسية</a>
                </div>
            `;
        } 
        // لو الرابط فاضي (يعني دي لوحة تحكم المشرف)
        else {
            contentDiv.innerHTML = `
                <div id="login-box" class="space-y-3">
                    <p class="text-sm font-medium text-gray-700">أدخل كلمة مرور المشرف:</p>
                    <input type="password" id="admin-pass" placeholder="كلمة المرور" class="w-full px-4 py-2 border rounded-lg text-center focus:ring-2 focus:ring-blue-500 outline-none">
                    <button onclick="loginAdmin()" class="w-full bg-blue-600 text-white py-2.5 rounded-lg font-medium hover:bg-blue-700 transition">دخول لوحة التحكم</button>
                </div>
            `;
        }

        function loginAdmin() {
            const pass = document.getElementById('admin-pass').value;
            // كلمة المرور الخاصة بك
            if (pass === "23122002YY") {
                renderDashboard();
            } else {
                alert("كلمة المرور غير صحيحة!");
            }
        }

        function renderDashboard() {
            const app = document.getElementById('app');
            app.className = "bg-white text-gray-900 p-6 rounded-2xl shadow-2xl w-full max-w-2xl text-right space-y-6";
            
            let logs = JSON.parse(localStorage.getItem('yossr_attendance_logs')) || [];
            
            let logsHtml = logs.length === 0 ? '<p class="text-gray-400 text-xs text-center">لا توجد سجلات حضور حتى الآن.</p>' : '';
            logs.forEach(l => {
                logsHtml += `
                    <div class="flex justify-between items-center bg-gray-50 p-2.5 rounded border text-xs">
                        <span><b>${l.name}</b> <span class="text-gray-500 font-mono">(${l.code})</span></span>
                        <span class="text-gray-500">${l.date}</span>
                    </div>
                `;
            });

            app.innerHTML = `
                <div class="flex justify-between items-center border-b pb-3">
                    <h2 class="text-xl font-bold text-blue-600">لوحة تحكم الحضور - مستر يسر الموافي</h2>
                    <button onclick="location.reload()" class="bg-red-500 text-white px-3 py-1 rounded text-xs">خروج</button>
                </div>

                <div class="space-y-3 bg-blue-50 p-4 rounded-xl border border-blue-200">
                    <h3 class="font-bold text-sm text-blue-900">إنشاء رابط طالب جديد للـ QR:</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                        <input type="text" id="p-name" placeholder="اسم الطالب الكامل" class="px-3 py-2 border rounded text-sm bg-white">
                        <input type="text" id="p-code" placeholder="الرقم التعريفي (مثال: YOSS-101)" class="px-3 py-2 border rounded text-sm bg-white">
                    </div>
                    <button onclick="generateStudentLink()" class="w-full bg-green-600 text-white py-2 rounded text-sm font-medium hover:bg-green-700 transition">توليد وعرض رابط الطالب</button>
                    <div id="link-result" class="hidden pt-2 text-xs font-mono break-all bg-white p-3 rounded border text-blue-700"></div>
                </div>

                <div class="space-y-2">
                    <div class="flex justify-between items-center">
                        <h3 class="font-bold text-sm text-gray-800">سجل الطلاب الحاضرين:</h3>
                        <button onclick="clearLogs()" class="text-red-500 text-xs underline">مسح السجل</button>
                    </div>
                    <div class="space-y-1.5 max-h-60 overflow-y-auto border p-2 rounded bg-white">
                        ${logsHtml}
                    </div>
                </div>
            `;
        }

        function generateStudentLink() {
            const name = document.getElementById('p-name').value.trim();
            const code = document.getElementById('p-code').value.trim();
            const resBox = document.getElementById('link-result');

            if (!name || !code) {
                alert("الرجاء إدخال اسم الطالب والرقم التعريفي!");
                return;
            }

            const baseUrl = window.location.origin + window.location.pathname;
            const finalUrl = `${baseUrl}?name=${encodeURIComponent(name)}&code=${encodeURIComponent(code)}`;

            resBox.classList.remove('hidden');
            resBox.innerHTML = `
                <b>رابط الطالب (خده حطه في موقع توليد الـ QR):</b><br>
                <a href="${finalUrl}" target="_blank" class="text-blue-600 underline">${finalUrl}</a>
            `;
        }

        function clearLogs() {
            if(confirm("هل أنت متأكد من مسح سجل الحضور؟")) {
                localStorage.removeItem('yossr_attendance_logs');
                renderDashboard();
            }
        }
    </script>
</body>
</html>
